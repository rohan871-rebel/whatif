# ==============================================================================
# GHOST SIGNAL — WHAT IF? Environment Configuration Template
# Research Demonstration Platform • OptiForge 2026 Hackathon
# ==============================================================================
# Instructions: Copy this file to .env and configure values for your environment.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Use * for development or specify domains:
# ALLOWED_ORIGINS=https://frontend-lemon-six-43.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Dataset & File Upload Security Limits
MAX_UPLOAD_SIZE_MB=5
MIN_CSV_ROWS=20
MAX_CSV_ROWS=5000

# Machine Learning Reproducibility
RANDOM_SEED=42

# Frontend Public API URL (optional for production builds)
# VITE_API_URL=https://whatif-kche.onrender.com/api
